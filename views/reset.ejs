<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Xarajat.uz - Yangi parol</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="auth-page">
    <div class="auth-card">
      <div class="auth-logo">Xarajat<span>.uz</span></div>
      <h2>Yangi parol o'rnatish</h2>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
        <p class="auth-link"><a href="/login">Tizimga kirish</a></p>
      <% } else { %>
        <form method="POST" action="/reset/<%= token %>">
          <div class="form-group">
            <label>Yangi parol</label>
            <input type="password" name="password" required placeholder="Kamida 6 ta belgi" minlength="6">
          </div>
          <div class="form-group">
            <label>Parolni tasdiqlash</label>
            <input type="password" name="password2" required placeholder="Parolni qaytaring">
          </div>
          <button type="submit" class="btn btn-primary btn-full">Parolni yangilash</button>
        </form>
        <p class="auth-link"><a href="/login">Tizimga kirish</a></p>
      <% } %>
    </div>
  </div>
</body>
</html>
