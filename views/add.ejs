<%- include('header') %>

<div class="form-page">
  <h1 class="page-title"><%= editing ? 'Tahrirlash' : "Daromad / Xarajat qo'shish" %></h1>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form method="POST" action="<%= editing ? '/edit/' + editing.id : '/add' %>" class="add-form">
    <div class="form-row">
      <div class="form-group">
        <label>Turi</label>
        <div class="toggle-group">
          <label class="toggle-option">
            <input type="radio" name="type" value="income" id="type-income"
              <%= (editing && editing.type === 'income') || !editing ? 'checked' : '' %>>
            <span class="toggle-label income">Daromad</span>
          </label>
          <label class="toggle-option">
            <input type="radio" name="type" value="expense" id="type-expense"
              <%= editing && editing.type === 'expense' ? 'checked' : '' %>>
            <span class="toggle-label expense">Xarajat</span>
          </label>
        </div>
      </div>

      <div class="form-group">
        <label>To'lov turi</label>
        <div class="toggle-group">
          <label class="toggle-option">
            <input type="radio" name="payment_type" value="cash"
              <%= (editing && editing.payment_type === 'cash') || !editing ? 'checked' : '' %>>
            <span class="toggle-label cash-toggle">Naqd</span>
          </label>
          <label class="toggle-option">
            <input type="radio" name="payment_type" value="card"
              <%= editing && editing.payment_type === 'card' ? 'checked' : '' %>>
            <span class="toggle-label card-toggle">Plastik karta</span>
          </label>
        </div>
      </div>
    </div>

    <div class="form-group">
      <label>Kategoriya</label>
      <select name="category" id="category-select" required>
        <option value="">Tanlang...</option>
      </select>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Summa (so'm)</label>
        <input type="number" name="amount" required min="1" step="100"
          placeholder="0" value="<%= editing ? editing.amount : '' %>">
      </div>

      <div class="form-group">
        <label>Sana</label>
        <input type="date" name="date" required
          value="<%= editing ? editing.date : new Date().toISOString().split('T')[0] %>">
      </div>
    </div>

    <div class="form-group">
      <label>Izoh (ixtiyoriy)</label>
      <input type="text" name="description" placeholder="Qo'shimcha ma'lumot..."
        value="<%= editing ? editing.description : '' %>">
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-full">
        <%= editing ? 'Saqlash' : "Qo'shish" %>
      </button>
      <a href="/" class="btn btn-secondary btn-full">Bekor qilish</a>
    </div>
  </form>
</div>

<script>
  const categories = <%- JSON.stringify(categories) %>;
  const editingCategory = '<%= editing ? editing.category : '' %>';

  function updateCategories() {
    const type = document.querySelector('input[name="type"]:checked').value;
    const select = document.getElementById('category-select');
    select.innerHTML = '<option value="">Tanlang...</option>';
    categories[type].forEach(function(cat) {
      const opt = document.createElement('option');
      opt.value = cat;
      opt.textContent = cat;
      if (cat === editingCategory) opt.selected = true;
      select.appendChild(opt);
    });
  }

  document.querySelectorAll('input[name="type"]').forEach(function(radio) {
    radio.addEventListener('change', updateCategories);
  });

  updateCategories();
</script>

<%- include('footer') %>
